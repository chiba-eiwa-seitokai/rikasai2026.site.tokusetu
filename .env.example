# Supabase PostgreSQL — Transaction Pooler (port 6543) for Vercel serverless
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Supabase PostgreSQL — Direct connection (port 5432) for Prisma migrations
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

# Admin panel password
ADMIN_SECRET="your-strong-admin-password-here"

# Supabase project URL (Settings → API → Project URL)
# Required for image uploads (/api/upload) — without this, the image
# upload fields on the 企画追加/編集 admin form will fail.
SUPABASE_URL="https://your-project.supabase.co"

# Supabase service role key (Settings → API → service_role secret)
# Required for image uploads. Also requires a public storage bucket
# named "event-images" to exist in the Supabase project.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
